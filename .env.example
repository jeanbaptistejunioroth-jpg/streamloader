# ─── Serveur ──────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# ─── Sécurité — CHANGER OBLIGATOIREMENT en production ! ──────────
JWT_SECRET=change_me_to_a_long_random_secret
# Chiffrement des clés API Premium (pour pouvoir les recopier depuis le compte).
# Valeur aléatoire longue ; ne plus la changer ensuite (les clés deviendraient illisibles).
API_KEY_SECRET=change_me_to_a_long_random_secret

# ─── Base de données SQLite ───────────────────────────────────────
DB_PATH=./data/streamloader.db

# ═══════════════════════════════════════════════════════════════════
#  PASSERELLE DE PAIEMENT : GENIUSPAY
#  Inscription/clés : https://pay.geniuspay.io/dashboard → Paramètres → API
#  GENIUSPAY_API_KEY = clé publique (pk_...), GENIUSPAY_API_SECRET = clé secrète (sk_...)
#  N'oublie pas de configurer aussi l'URL du webhook dans le dashboard GeniusPay
#  (Paramètres → Webhooks) : <APP_URL>/api/payment/webhook/geniuspay
# ═══════════════════════════════════════════════════════════════════
GENIUSPAY_API_KEY=
GENIUSPAY_API_SECRET=
GENIUSPAY_API_URL=https://geniuspay.ci/api/v1/merchant
GENIUSPAY_WEBHOOK_SECRET=change_me_to_a_long_random_secret

# ═══════════════════════════════════════════════════════════════════
#  PUBLICITÉ (visiteurs non Premium uniquement)
#  - Bannières : colle le code de ta régie dans les fichiers du dossier ads/ (chaque
#    fichier indique la taille exacte du cadre : 728×90, 468×60, et 320×100 / 320×50
#    pour les versions téléphone)
#  - Page ouverte au clic sur « Télécharger » : ton lien direct Monetag (Direct Link / Smartlink).
#    Vide = ouvre la page des tarifs Premium.
#  - AD_CSP_EXTRA : domaines supplémentaires chargés par la régie, si le navigateur
#    les bloque (erreur "Content Security Policy" dans la console). Séparés par des espaces.
# ═══════════════════════════════════════════════════════════════════
AD_REDIRECT_URL=
AD_CSP_EXTRA=

# ═══════════════════════════════════════════════════════════════════
#  OPTIONNEL
# ═══════════════════════════════════════════════════════════════════

# Google Analytics
# GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_PREMIUM_IDS=
# Taille maximale d'un fichier envoyé par le bot. Telegram plafonne les bots à
# 50 Mo sur son API publique. Pour 100 Mo (ou plus, jusqu'à 2000), il faut un
# « serveur Bot API local » sur le VPS : voir VPS_DEPLOY_GUIDE.md, partie 6 bis.
# Sur le VPS, une fois ce serveur installé :
#   TELEGRAM_API_URL=http://127.0.0.1:8081
#   TELEGRAM_MAX_FILE_MB=100
TELEGRAM_API_URL=
TELEGRAM_MAX_FILE_MB=

# Reconnaissance audio (bouton "Musique Officielle" du bot Telegram) — RapidAPI
SHAZAM_API_KEY=
SHAZAM_API_HOST=shazam-api-free.p.rapidapi.com

# Page de modération des avis (/admin-reviews.html) — génère une valeur
# aléatoire longue, garde-la secrète, ne la partage/lie nulle part publiquement.
ADMIN_TOKEN=change_me_to_a_long_random_secret
